-> Tutorial step 3's module: the exact same handler from step 2, now
-> living in its own file. Nothing about the handler changed — only where
-> it lives.
Order = Particle ∩ { _class ∈ "Order", item ∈ String, quantity ∈ Number, unit_price ∈ Number }
ValidatedOrder = Particle ∩ { _class ∈ "ValidatedOrder", item ∈ String, quantity ∈ Number, unit_price ∈ Number, total ∈ Number }
RejectedOrder = Particle ∩ { _class ∈ "RejectedOrder", item ∈ String, reason ∈ String }

Order => {
    if quantity > 0 {
        return ValidatedOrder {
            item = item, quantity = quantity, unit_price = unit_price,
            total = quantity * unit_price
        }
    }
    if quantity ≤ 0 {
        return RejectedOrder { item = item, reason = "quantity must be positive" }
    }
}
