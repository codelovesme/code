-> Reference: values and literals — Number, String (with $interpolation),
-> Boolean, Null, Object, Array, Set.
n = 42
pi = 3.14
name = "Ada"
greeting = "Hello, $name!"
active = true
nothing = Null
point = { x = 1, y = 2 }
nums = [1, 2, 3]
tags = { "a", "b", "c" }

assert n = 42
assert greeting = "Hello, Ada!"
assert point.x = 1
assert nums[1] = 2
assert tags ∈ Set
