use std::collections::HashMap;
use std::rc::Rc;
use std::time::Duration;

use crate::ast::{BinaryOp, Expression, HandlerTarget, Program, Statement, TypeExpr, UnaryOp};
use crate::environment::Environment;
use crate::native_module::EmitQueue;
use crate::runtime::Value;

/// Tree-walking interpreter for Code.
/// Executes a parsed AST using the Environment/Rc<Value> memory model.
pub struct Interpreter {
    env: Environment,
    /// Holds the value from a `return expr` statement.
    /// Checked after each statement in callable body to stop execution.
    handler_return_value: Option<Rc<Value>>,
    /// Depth counter for handler invocations (to validate `return` is inside a handler).
    in_handler_depth: usize,
    /// Depth counter for function calls (to validate `return` is inside a function).
    in_function_depth: usize,
    /// Signal to break out of the nearest enclosing loop.
    break_signal: bool,
    /// Depth counter for loop invocations (to validate `break` is inside a loop).
    in_loop_depth: usize,
    /// Emission queues from loaded native modules — drained after each statement.
    emit_queues: Vec<EmitQueue>,
    /// Set to true when a native module emits `__KeepAlive`, keeping the process
    /// alive after all program statements finish (e.g. background HTTP server).
    keep_alive: bool,
}

impl Interpreter {
    /// Create a new interpreter with a fresh global environment.
    pub fn new() -> Self {
        Interpreter {
            env: Environment::new(),
            handler_return_value: None,
            in_handler_depth: 0,
            in_function_depth: 0,
            break_signal: false,
            in_loop_depth: 0,
            emit_queues: Vec::new(),
            keep_alive: false,
        }
    }

    /// Execute an entire program (list of statements in order).
    pub fn execute(&mut self, program: Program) -> Result<(), String> {
        for stmt in program.statements {
            self.exec_statement(stmt)?;
            // If assert (or handler return) set handler_return_value, exit early.
            if self.handler_return_value.is_some() {
                break;
            }
            // Drain any particles emitted by native modules.
            self.drain_native_emissions()?;
        }

        // If an unhandled Exception reached root level, report it as an error.
        if let Some(val) = self.handler_return_value.take() {
            if let Value::Object(fields) = val.as_ref() {
                let is_exception = fields.get("_class")
                    .and_then(|v| if let Value::String(s) = v.as_ref() { Some(s.as_str()) } else { None })
                    .map_or(false, |cls| cls == "Exception");
                if is_exception {
                    let msg = fields.get("message")
                        .and_then(|v| if let Value::String(s) = v.as_ref() { Some(s.clone()) } else { None })
                        .unwrap_or_else(|| "Exception".to_string());
                    return Err(msg);
                }
            }
        }

        // If a native module emitted __KeepAlive (e.g. background HTTP server),
        // keep draining emissions until the process is terminated.
        while self.keep_alive {
            self.drain_native_emissions()?;
            std::thread::sleep(Duration::from_millis(10));
        }

        Ok(())
    }

    /// Execute a single statement.
    fn exec_statement(&mut self, stmt: Statement) -> Result<(), String> {
        match stmt {
            Statement::Link { module_ref, .. } => {
                return Err(format!(
                    "Unresolved module link '{}': links must be resolved before execution",
                    module_ref
                ));
            }
            Statement::PrivateAssignment { name, value } => {
                let val = self.eval_expr(value)?;
                if self.env.get(&name).is_some() {
                    self.env.assign(&name, val)?;
                } else {
                    self.env.define(name, val);
                }
            }
            Statement::PrivateTypedAssignment { name, type_expr, value } => {
                let val = self.eval_expr(value)?;
                self.check_type_expr(&val, &type_expr, &name)?;
                if self.env.get(&name).is_some() {
                    self.env.assign(&name, val)?;
                } else {
                    self.env.define_typed(name, type_expr, val);
                }
            }
            Statement::TypeDeclaration { name, fields } => {
                self.env.define_type(name, fields);
            }
            Statement::TypeAliasDeclaration { name, type_expr } => {
                // Disallow if name clashes with an existing type or alias.
                if self.env.get_type(&name).is_some() {
                    return Err(format!("Name '{}' is already defined as a type", name));
                }
                if self.env.get_type_alias(&name).is_some() {
                    return Err(format!("Type alias '{}' is already defined", name));
                }
                self.env.define_type_alias(name, type_expr);
            }
            Statement::TypedAssignment { name, type_expr, value } => {
                let val = self.eval_expr(value)?;
                self.check_type_expr(&val, &type_expr, &name)?;
                if self.env.get(&name).is_some() {
                    self.env.assign(&name, val)?;
                } else {
                    self.env.define_typed(name, type_expr, val);
                }
            }
            Statement::PropertyAssignment { target, field, value } => {
                let val = self.eval_expr(value)?;
                self.exec_property_assignment(&target, &field, val)?;
            }
            Statement::HandlerDefinition { class_name, inline_type, body } => {
                if self.in_function_depth > 0 {
                    return Err("Handler definitions are not allowed inside functions".to_string());
                }
                if let Some(fields) = inline_type {
                    self.env.define_type(class_name.clone(), fields);
                }
                self.env.define_handler(class_name, body)?;
            }
            Statement::HandlerInvoke { particle, target } => {
                if self.in_function_depth > 0 {
                    return Err("Handler invocations are not allowed inside functions".to_string());
                }
                let val = self.eval_expr(particle)?;
                self.exec_handler_invoke(&val, &target)?;
            }
            Statement::HandlerInvokeAssign { particle, target, result_name } => {
                if self.in_function_depth > 0 {
                    return Err("Handler invocations are not allowed inside functions".to_string());
                }
                let val = self.eval_expr(particle)?;
                let result = self.exec_handler_invoke(&val, &target)?;
                if self.env.get(&result_name).is_some() {
                    self.env.assign(&result_name, result)?;
                } else {
                    self.env.define(result_name, result);
                }
            }
            Statement::HandlerReturn { value } => {
                if self.in_handler_depth == 0 && self.in_function_depth == 0 {
                    return Err("Return statement 'return' used outside of a handler or function".to_string());
                }
                let val = self.eval_expr(value)?;
                // Enforce: handlers (not functions) must return Particles.
                if self.in_handler_depth > 0 && self.in_function_depth == 0 {
                    match val.as_ref() {
                        Value::Object(fields) if fields.contains_key("_class") => {}
                        _ => return Err(
                            "Handler return must be a Particle (object with _class), got a non-particle value"
                                .to_string(),
                        ),
                    }
                }
                self.handler_return_value = Some(val);
            }
            Statement::Import { alias, body, public_names, public_types, public_handlers, public_aliases } => {
                self.env.push_scope();
                for stmt in body {
                    self.exec_statement(stmt)?;
                }

                match alias {
                    Some(alias_name) => {
                        let mut map = HashMap::new();
                        for name in &public_names {
                            let val = self.env.get(name).ok_or_else(|| {
                                format!(
                                    "Module declares public name '{}' but it was never defined",
                                    name
                                )
                            })?;
                            map.insert(name.clone(), val);
                        }
                        self.env.pop_scope();
                        let module_val = Value::object(map);
                        self.env.define(alias_name.clone(), module_val);
                        for t in &public_types {
                            self.env.define_type(
                                format!("{}.{}", alias_name, t.name),
                                t.fields.clone(),
                            );
                        }
                        for h in &public_handlers {
                            self.env.define_handler(
                                format!("{}.{}", alias_name, h.class_name),
                                h.body.clone(),
                            )?;
                        }
                        for a in &public_aliases {
                            self.env.define_type_alias(
                                format!("{}.{}", alias_name, a.name),
                                a.type_expr.clone(),
                            );
                        }
                    }
                    None => {
                        let mut vals = Vec::new();
                        for name in &public_names {
                            let val = self.env.get(name).ok_or_else(|| {
                                format!(
                                    "Module declares public name '{}' but it was never defined",
                                    name
                                )
                            })?;
                            vals.push((name.clone(), val));
                        }
                        self.env.pop_scope();
                        for (name, val) in vals {
                            if self.env.get(&name).is_some() {
                                return Err(format!(
                                    "Name conflict: linked module defines '{}' which already exists in the current scope",
                                    name
                                ));
                            }
                            self.env.define(name, val);
                        }
                        for t in &public_types {
                            self.env.define_type(t.name.clone(), t.fields.clone());
                        }
                        for h in &public_handlers {
                            self.env.define_handler(h.class_name.clone(), h.body.clone())?;
                        }
                        for a in &public_aliases {
                            self.env.define_type_alias(a.name.clone(), a.type_expr.clone());
                        }
                    }
                }
            }
            Statement::NativeImport { alias, native_path: _, is_wasm: _, vars, functions, handlers, types, emissions: _, emit_queue } => {
                // Register the emit queue so we can drain emitted particles.
                self.emit_queues.push(emit_queue);

                match alias {
                    Some(alias_name) => {
                        // Namespace mode: create module object with all vars + functions.
                        let mut map = HashMap::new();
                        for (name, val) in &vars {
                            map.insert(name.clone(), Rc::clone(val));
                        }
                        for (name, func, param_count) in &functions {
                            map.insert(
                                name.clone(),
                                Value::native_function(name.clone(), *param_count, func.clone()),
                            );
                        }
                        let module_val = Value::object(map);
                        self.env.define(alias_name.clone(), module_val);

                        // Register types under alias.
                        for t in &types {
                            self.env.define_type(
                                format!("{}.{}", alias_name, t.name),
                                t.fields.clone(),
                            );
                        }
                        // Register native handlers under alias.
                        for h in &handlers {
                            self.env.define_native_handler(
                                format!("{}.{}", alias_name, h.class_name),
                                h.func.clone(),
                            )?;
                        }
                    }
                    None => {
                        // Flatten mode: define vars and functions directly in current scope.
                        for (name, val) in &vars {
                            if self.env.get(name).is_some() {
                                return Err(format!(
                                    "Name conflict: native module defines '{}' which already exists in the current scope",
                                    name
                                ));
                            }
                            self.env.define(name.clone(), Rc::clone(val));
                        }
                        for (name, func, param_count) in &functions {
                            if self.env.get(name).is_some() {
                                return Err(format!(
                                    "Name conflict: native module defines '{}' which already exists in the current scope",
                                    name
                                ));
                            }
                            self.env.define(
                                name.clone(),
                                Value::native_function(name.clone(), *param_count, func.clone()),
                            );
                        }
                        for t in &types {
                            self.env.define_type(t.name.clone(), t.fields.clone());
                        }
                        for h in &handlers {
                            self.env.define_native_handler(h.class_name.clone(), h.func.clone())?;
                        }
                    }
                }
            }
            Statement::Assignment { name, value } => {
                let val = self.eval_expr(value)?;
                if self.env.get(&name).is_some() {
                    if let Some(ann) = self.env.get_type_annotation(&name) {
                        let ann = ann.clone();
                        self.check_type_expr(&val, &ann, &name)?;
                    }
                    self.env.assign(&name, val)?;
                } else {
                    self.env.define(name, val);
                }
            }
            Statement::Assert(expr) => {
                let val = self.eval_expr(expr)?;
                match val.as_ref() {
                    Value::Boolean(true) => { /* assertion passed */ }
                    Value::Boolean(false) => {
                        // Build Exception and return it via handler_return_value.
                        let mut fields = HashMap::new();
                        fields.insert("_class".to_string(), Value::string("Exception"));
                        fields.insert("message".to_string(), Value::string("Assertion failed"));
                        fields.insert("innerException".to_string(), Value::null());
                        self.handler_return_value = Some(Value::object(fields));
                    }
                    Value::Object(fields) => {
                        // If the value is an Exception particle, return it via handler_return_value.
                        let is_exception = fields.get("_class")
                            .and_then(|v| if let Value::String(s) = v.as_ref() { Some(s.as_str()) } else { None })
                            .map_or(false, |cls| cls == "Exception");
                        if is_exception {
                            self.handler_return_value = Some(val);
                        }
                        // Non-exception object — assertion passes.
                    }
                    _ => {
                        // Any other non-boolean, non-object value — assertion passes
                        // (the value exists and is not an Exception).
                    }
                }
            }
            Statement::Block(stmts) => {
                self.env.push_scope();
                let result = self.exec_block_stmts(stmts);
                self.env.pop_scope();
                result?;
            }
            Statement::If { condition, body } => {
                let cond_val = self.eval_expr(condition)?;
                match cond_val.as_ref() {
                    Value::Boolean(true) => {
                        self.env.push_scope();
                        // Execute if body without shadow check — allow reassigning outer vars.
                        for stmt in body {
                            self.exec_statement(stmt)?;
                            if self.handler_return_value.is_some() || self.break_signal {
                                break;
                            }
                        }
                        self.env.pop_scope();
                    }
                    Value::Boolean(false) => { /* skip */ }
                    _ => return Err("If condition must be a Boolean".to_string()),
                }
            }
            Statement::LoopOver { variable, iterable, body } => {
                let iter_val = self.eval_expr(iterable)?;
                match iter_val.as_ref() {
                    Value::Array(elements) => {
                        self.in_loop_depth += 1;
                        for element in elements.clone() {
                            self.env.push_scope();
                            self.env.define(variable.clone(), element);
                            // Execute loop body without shadow check — allow reassigning outer vars.
                            for stmt in body.clone() {
                                self.exec_statement(stmt)?;
                                if self.handler_return_value.is_some() || self.break_signal {
                                    break;
                                }
                            }
                            self.env.pop_scope();
                            if self.break_signal {
                                self.break_signal = false;
                                break;
                            }
                            if self.handler_return_value.is_some() {
                                break;
                            }
                        }
                        self.in_loop_depth -= 1;
                    }
                    _ => return Err("Loop requires an Array value to iterate over".to_string()),
                }
            }
            Statement::LoopInfinite { body } => {
                self.in_loop_depth += 1;
                loop {
                    self.env.push_scope();
                    for stmt in body.clone() {
                        self.exec_statement(stmt)?;
                        // Drain native emissions after each statement in the loop.
                        self.drain_native_emissions()?;
                        if self.handler_return_value.is_some() || self.break_signal {
                            break;
                        }
                    }
                    self.env.pop_scope();
                    if self.break_signal {
                        self.break_signal = false;
                        break;
                    }
                    if self.handler_return_value.is_some() {
                        break;
                    }
                }
                self.in_loop_depth -= 1;
            }
            Statement::Break => {
                if self.in_loop_depth == 0 {
                    return Err("Break statement used outside of a loop".to_string());
                }
                self.break_signal = true;
            }
        }
        Ok(())
    }

    /// Execute statements inside a block, checking the no-shadowing rule.
    fn exec_block_stmts(&mut self, stmts: Vec<Statement>) -> Result<(), String> {
        for stmt in stmts {
            let name_to_check = match &stmt {
                Statement::Assignment { name, .. } => Some(name.clone()),
                Statement::TypedAssignment { name, .. } => Some(name.clone()),
                _ => None,
            };
            if let Some(name) = name_to_check {
                if self.env.exists_in_any_scope(&name) && self.env.get(&name).is_some() {
                    if !self.env.current_scope_has(&name) {
                        return Err(format!(
                            "Cannot redefine '{}' inside block: shadowing is not allowed",
                            name
                        ));
                    }
                }
            }
            self.exec_statement(stmt)?;
            // Propagate handler return signal.
            if self.handler_return_value.is_some() {
                break;
            }
            // Propagate break signal.
            if self.break_signal {
                break;
            }
        }
        Ok(())
    }

    /// Check that a value matches the expected type expression.
    fn check_type_expr(&self, val: &Value, expected: &TypeExpr, var_name: &str) -> Result<(), String> {
        if !self.value_matches_type_expr(val, expected, &mut Vec::new()) {
            return Err(format!(
                "Type mismatch for '{}': expected {}, got {}",
                var_name, expected, val.type_name()
            ));
        }
        Ok(())
    }

    /// Recursively check if a value matches a type expression.
    /// `seen` tracks alias names to detect cycles.
    fn value_matches_type_expr(&self, val: &Value, type_expr: &TypeExpr, seen: &mut Vec<String>) -> bool {
        match type_expr {
            TypeExpr::Named(name) => {
                // Check built-in types first.
                match name.as_str() {
                    "Number" => matches!(val, Value::Number(_)),
                    "String" => matches!(val, Value::String(_)),
                    "Boolean" => matches!(val, Value::Boolean(_)),
                    "Object" => matches!(val, Value::Object(_)),
                    "Array" => matches!(val, Value::Array(_)),
                    "Null" => matches!(val, Value::Null),
                    "Function" => matches!(val, Value::Function { .. }),
                    _ => {
                        // Check if it's a type alias.
                        if let Some(alias_expr) = self.env.get_type_alias(name).cloned() {
                            if seen.contains(name) {
                                // Cycle detected — treat as non-matching.
                                return false;
                            }
                            seen.push(name.clone());
                            let result = self.value_matches_type_expr(val, &alias_expr, seen);
                            seen.pop();
                            return result;
                        }
                        // Check particle _class field.
                        let expected_class = if let Some(dot_pos) = name.rfind('.') {
                            &name[dot_pos+1..]
                        } else {
                            name.as_str()
                        };
                        match val {
                            Value::Object(fields) => {
                                fields.get("_class")
                                    .and_then(|v| if let Value::String(s) = v.as_ref() { Some(s.as_str()) } else { None })
                                    .map_or(false, |cls| cls == expected_class)
                            }
                            _ => false,
                        }
                    }
                }
            }
            TypeExpr::Literal(s) => {
                match val {
                    Value::String(v) => v == s,
                    _ => false,
                }
            }
            TypeExpr::Union(variants) => {
                variants.iter().any(|v| self.value_matches_type_expr(val, v, seen))
            }
        }
    }

    /// Execute a property assignment: `target.field = value`.
    fn exec_property_assignment(
        &mut self,
        target: &str,
        field: &str,
        new_val: Rc<Value>,
    ) -> Result<(), String> {
        let obj = self
            .env
            .get(target)
            .ok_or_else(|| format!("Undefined variable '{}'", target))?;
        match obj.as_ref() {
            Value::Object(fields) => {
                if let Some(class_val) = fields.get("_class") {
                    if let Value::String(class_name) = class_val.as_ref() {
                        if let Some(schema) = self.env.get_type(class_name).cloned() {
                            if let Some((_, expected_type, is_optional)) = schema.iter().find(|(n, _, _)| n == field) {
                                let ok_null = *is_optional && matches!(new_val.as_ref(), Value::Null);
                                if !ok_null && !self.value_matches_type_expr(&new_val, expected_type, &mut Vec::new()) {
                                    return Err(format!(
                                        "Type mismatch for property '{}' of '{}': expected {}, got {}",
                                        field, class_name, expected_type, new_val.type_name()
                                    ));
                                }
                            }
                        }
                    }
                }

                if !fields.contains_key(field) {
                    return Err(format!("Field '{}' not found in object", field));
                }

                let mut new_fields = fields.clone();
                new_fields.insert(field.to_string(), new_val);
                let new_obj = Value::object(new_fields);
                self.env.assign(target, new_obj)?;
                Ok(())
            }
            other => Err(format!(
                "Cannot assign property '{}' on non-object value: {}",
                field, other
            )),
        }
    }

    /// Execute a handler invocation: evaluate particle, resolve handler, dispatch.
    /// Returns the handler's return value (defaults to Null if no `<=`).
    fn exec_handler_invoke(
        &mut self,
        particle_val: &Rc<Value>,
        target: &HandlerTarget,
    ) -> Result<Rc<Value>, String> {
        let class_name = match particle_val.as_ref() {
            Value::Object(fields) => {
                match fields.get("_class") {
                    Some(class_val) => match class_val.as_ref() {
                        Value::String(s) => s.clone(),
                        _ => return Err("Particle _class field is not a string".to_string()),
                    },
                    None => return Err("Cannot dispatch non-particle value (missing _class)".to_string()),
                }
            }
            _ => return Err("Cannot dispatch non-object value as particle".to_string()),
        };

        let handler_bodies: Vec<Vec<Statement>> = match target {
            HandlerTarget::This => self
                .env
                .get_handler(&class_name)
                .cloned()
                .into_iter()
                .collect(),
            HandlerTarget::ModuleAlias(alias) => self
                .env
                .get_handler(&format!("{}.{}", alias, class_name))
                .cloned()
                .into_iter()
                .collect(),
            HandlerTarget::Base => self.env.get_handlers_outside_current_scope(&class_name),
        };

        // Look up native handlers as well.
        let native_handlers: Vec<crate::native_module::NativeFnPtr> = match target {
            HandlerTarget::This => self
                .env
                .get_native_handler(&class_name)
                .cloned()
                .into_iter()
                .collect(),
            HandlerTarget::ModuleAlias(alias) => self
                .env
                .get_native_handler(&format!("{}.{}", alias, class_name))
                .cloned()
                .into_iter()
                .collect(),
            HandlerTarget::Base => self.env.get_native_handlers_outside_current_scope(&class_name),
        };

        if handler_bodies.is_empty() && native_handlers.is_empty() {
            return Ok(Value::null());
        }

        let mut last_result = Value::null();

        for handler_body in handler_bodies {
            self.env.push_scope();
            self.in_handler_depth += 1;

            if let Value::Object(fields) = particle_val.as_ref() {
                for (name, val) in fields {
                    if name != "_class" && name != "_created" {
                        self.env.define(name.clone(), Rc::clone(val));
                    }
                }
            }

            let mut exec_error: Option<String> = None;
            for stmt in handler_body {
                if let Err(e) = self.exec_statement(stmt) {
                    exec_error = Some(e);
                    break;
                }
                if self.handler_return_value.is_some() {
                    break;
                }
            }

            self.in_handler_depth -= 1;
            self.env.pop_scope();

            if let Some(e) = exec_error {
                return Err(e);
            }

            last_result = self
                .handler_return_value
                .take()
                .unwrap_or_else(|| Value::null());
        }

        // Execute native handlers.
        for native_fn in native_handlers {
            let result = (native_fn.0)(vec![Rc::clone(particle_val)])?;
            last_result = result;
        }

        Ok(last_result)
    }

    // -----------------------------------------------------------------------
    // Native emission draining
    // -----------------------------------------------------------------------

    /// Drain all emission queues from loaded native modules and dispatch
    /// each emitted particle to handlers in the current scope.
    fn drain_native_emissions(&mut self) -> Result<(), String> {
        // Collect emitted particles from all queues.
        let mut emitted_particles: Vec<Rc<Value>> = Vec::new();
        for queue in &self.emit_queues {
            if let Ok(mut q) = queue.lock() {
                while let Some(emitted_val) = q.pop_front() {
                    emitted_particles.push(emitted_val.to_value());
                }
            }
        }

        // Dispatch each emitted particle to handlers in the current scope.
        for particle in emitted_particles {
            if let Value::Object(fields) = particle.as_ref() {
                if let Some(class) = fields.get("_class") {
                    if let Value::String(s) = class.as_ref() {
                        if s == "__KeepAlive" {
                            self.keep_alive = true;
                            continue;
                        }
                    }
                    // Dispatch to This target — handlers in the current scope.
                    self.exec_handler_invoke(&particle, &HandlerTarget::This)?;
                }
            }
        }

        Ok(())
    }

    /// Execute a function call: evaluate args, bind params, run body, return result.
    fn exec_function_call(
        &mut self,
        params: &[crate::ast::FunctionParam],
        args: Vec<Expression>,
        body: &[Statement],
        return_type: &Option<TypeExpr>,
    ) -> Result<Rc<Value>, String> {
        // Evaluate arguments eagerly (before isolating scope).
        let mut arg_vals = Vec::new();
        for arg in args {
            arg_vals.push(self.eval_expr(arg)?);
        }

        if arg_vals.len() > params.len() {
            return Err(format!(
                "Too many arguments: expected {}, got {}",
                params.len(),
                arg_vals.len()
            ));
        }

        // Save interpreter state for isolation.
        let saved_return = self.handler_return_value.take();
        let saved_break = self.break_signal;
        let saved_loop_depth = self.in_loop_depth;

        self.in_function_depth += 1;
        self.break_signal = false;
        self.in_loop_depth = 0;

        // Isolate the environment: functions cannot see outer variables.
        // Type definitions and handler definitions are carried over.
        let saved_env = self.env.save_and_isolate_scopes();

        // Bind parameters.
        for (i, param) in params.iter().enumerate() {
            let val = if i < arg_vals.len() {
                arg_vals[i].clone()
            } else if let Some(ref default_expr) = param.default {
                self.eval_expr(default_expr.clone())?
            } else {
                return Err(format!("Missing argument for parameter '{}'", param.name));
            };

            // Type check if param has a type annotation.
            if let Some(ref tn) = param.type_expr {
                self.check_type_expr(&val, tn, &param.name)?;
            }

            if let Some(ref tn) = param.type_expr {
                self.env.define_typed(param.name.clone(), tn.clone(), val);
            } else {
                self.env.define(param.name.clone(), val);
            }
        }

        // Execute body.
        for stmt in body {
            self.exec_statement(stmt.clone())?;
            if self.handler_return_value.is_some() || self.break_signal {
                break;
            }
        }

        self.in_function_depth -= 1;

        let result = self.handler_return_value.take().unwrap_or_else(|| Value::null());

        // Validate return type if specified.
        if let Some(ref ret_type) = return_type {
            if !self.value_matches_type_expr(&result, ret_type, &mut Vec::new()) {
                return Err(format!(
                    "Function return type mismatch: expected {}, got {}",
                    ret_type, result.type_name()
                ));
            }
        }

        // Restore environment and state.
        self.env.restore_scopes(saved_env);
        self.handler_return_value = saved_return;
        self.break_signal = saved_break;
        self.in_loop_depth = saved_loop_depth;

        Ok(result)
    }

    /// Evaluate an expression, returning a heap-allocated value.
    fn eval_expr(&mut self, expr: Expression) -> Result<Rc<Value>, String> {
        match expr {
            Expression::Number(n) => Ok(Value::number(n)),
            Expression::String(s) => Ok(Value::string(s)),
            Expression::Boolean(b) => Ok(Value::boolean(b)),
            Expression::Null => Ok(Value::null()),
            Expression::Identifier(name) => self
                .env
                .get(&name)
                .ok_or_else(|| format!("Undefined variable '{}'", name)),
            Expression::Object { spread, fields } => {
                let mut map = HashMap::new();
                // If spread source, copy its fields first.
                if let Some(source_expr) = spread {
                    let source_val = self.eval_expr(*source_expr)?;
                    match source_val.as_ref() {
                        Value::Object(src_fields) => {
                            for (k, v) in src_fields {
                                map.insert(k.clone(), v.clone());
                            }
                        }
                        other => return Err(format!(
                            "Spread source must be an object, got {}",
                            other.type_name()
                        )),
                    }
                }
                for (name, expr) in fields {
                    let val = self.eval_expr(expr)?;
                    map.insert(name, val);
                }
                Ok(Value::object(map))
            }
            Expression::Particle { qualifier, class_name, spread, fields } => {
                let type_key = match &qualifier {
                    Some(q) => format!("{}.{}", q, class_name),
                    None => class_name.clone(),
                };

                let type_def = self.env.get_type(&type_key).cloned();

                // If spread source, evaluate and collect its fields.
                let mut spread_map: HashMap<String, Rc<Value>> = HashMap::new();
                if let Some(source_expr) = spread {
                    let source_val = self.eval_expr(*source_expr)?;
                    match source_val.as_ref() {
                        Value::Object(src_fields) => {
                            for (k, v) in src_fields {
                                // Skip internal fields — they are regenerated.
                                if k != "_class" && k != "_created" {
                                    spread_map.insert(k.clone(), v.clone());
                                }
                            }
                        }
                        other => return Err(format!(
                            "Spread source must be an object, got {}",
                            other.type_name()
                        )),
                    }
                }

                if let Some(ref schema_fields) = type_def {
                    let provided: std::collections::HashSet<&str> =
                        fields.iter().map(|(n, _)| n.as_str()).collect();
                    for (sf_name, _, is_optional) in schema_fields {
                        if !is_optional && !provided.contains(sf_name.as_str()) && !spread_map.contains_key(sf_name) {
                            return Err(format!(
                                "Missing field '{}' for type '{}'",
                                sf_name, type_key
                            ));
                        }
                    }
                    let schema_names: std::collections::HashSet<&str> =
                        schema_fields.iter().map(|(n, _, _)| n.as_str()).collect();
                    for (pf_name, _) in &fields {
                        if !schema_names.contains(pf_name.as_str()) {
                            return Err(format!(
                                "Unknown field '{}' for type '{}'",
                                pf_name, type_key
                            ));
                        }
                    }

                    let mut map = HashMap::new();
                    map.insert("_class".to_string(), Value::string(class_name.clone()));
                    map.insert("_created".to_string(), Value::number(0.0));

                    // Apply spread fields first.
                    for (k, v) in &spread_map {
                        map.insert(k.clone(), v.clone());
                    }

                    // Override with explicit fields.
                    for (name, expr) in fields {
                        let val = self.eval_expr(expr)?;
                        if let Some((_, expected_type, is_optional)) = schema_fields.iter().find(|(n, _, _)| n == &name) {
                            let ok_null = *is_optional && matches!(val.as_ref(), Value::Null);
                            if !ok_null && !self.value_matches_type_expr(&val, expected_type, &mut Vec::new()) {
                                return Err(format!(
                                    "Type mismatch for field '{}' of '{}': expected {}, got {}",
                                    name, type_key, expected_type, val.type_name()
                                ));
                            }
                        }
                        map.insert(name, val);
                    }

                    // Inject Null for missing optional fields.
                    for (sf_name, _, is_optional) in schema_fields {
                        if *is_optional && !map.contains_key(sf_name) {
                            map.insert(sf_name.clone(), Value::null());
                        }
                    }

                    Ok(Value::object(map))
                } else {
                    let mut map = HashMap::new();
                    map.insert("_class".to_string(), Value::string(class_name));
                    map.insert("_created".to_string(), Value::number(0.0));
                    for (k, v) in &spread_map {
                        map.insert(k.clone(), v.clone());
                    }
                    for (name, expr) in fields {
                        let val = self.eval_expr(expr)?;
                        map.insert(name, val);
                    }
                    Ok(Value::object(map))
                }
            }
            Expression::PropertyAccess(recv, field) => {
                let obj = self.eval_expr(*recv)?;
                match obj.as_ref() {
                    Value::Object(fields) => fields
                        .get(&field)
                        .cloned()
                        .ok_or_else(|| format!("Field '{}' not found in object", field)),
                    other => Err(format!(
                        "Cannot access property '{}' on non-object value: {}",
                        field, other
                    )),
                }
            }
            Expression::ArrayLiteral(elements) => {
                let mut vals = Vec::new();
                for elem in elements {
                    vals.push(self.eval_expr(elem)?);
                }
                Ok(Value::array(vals))
            }
            Expression::IndexAccess { receiver, index } => {
                let recv_val = self.eval_expr(*receiver)?;
                let idx_val = self.eval_expr(*index)?;
                match (recv_val.as_ref(), idx_val.as_ref()) {
                    (Value::Array(elements), Value::Number(n)) => {
                        let i = *n as usize;
                        if (i as f64) != *n || *n < 0.0 {
                            return Ok(Value::null());
                        }
                        Ok(elements.get(i).cloned().unwrap_or_else(|| Value::null()))
                    }
                    (Value::Array(_), _) => Err("Array index must be a Number".to_string()),
                    _ => Err("Index access requires an Array value".to_string()),
                }
            }
            Expression::InterpolatedString(parts) => {
                let mut result = String::new();
                for part in parts {
                    match part {
                        crate::ast::StringPart::Literal(s) => result.push_str(&s),
                        crate::ast::StringPart::Variable(name) => {
                            let val = self.env.get(&name).ok_or_else(|| {
                                format!("Undefined variable '{}' in string interpolation", name)
                            })?;
                            match val.as_ref() {
                                Value::String(s) => result.push_str(s),
                                Value::Number(n) => result.push_str(&n.to_string()),
                                Value::Boolean(b) => result.push_str(&b.to_string()),
                                Value::Null => result.push_str("Null"),
                                _ => result.push_str(&val.to_string()),
                            }
                        }
                    }
                }
                Ok(Value::string(result))
            }
            Expression::Binary { left, op, right } => {
                // Short-circuit logical operators.
                match op {
                    BinaryOp::And => {
                        let left_val = self.eval_expr(*left)?;
                        match left_val.as_ref() {
                            Value::Boolean(false) => return Ok(Value::boolean(false)),
                            Value::Boolean(true) => {
                                let right_val = self.eval_expr(*right)?;
                                match right_val.as_ref() {
                                    Value::Boolean(_) => return Ok(right_val),
                                    _ => return Err("Right operand of '&&' must be a Boolean".to_string()),
                                }
                            }
                            _ => return Err("Left operand of '&&' must be a Boolean".to_string()),
                        }
                    }
                    BinaryOp::Or => {
                        let left_val = self.eval_expr(*left)?;
                        match left_val.as_ref() {
                            Value::Boolean(true) => return Ok(Value::boolean(true)),
                            Value::Boolean(false) => {
                                let right_val = self.eval_expr(*right)?;
                                match right_val.as_ref() {
                                    Value::Boolean(_) => return Ok(right_val),
                                    _ => return Err("Right operand of '||' must be a Boolean".to_string()),
                                }
                            }
                            _ => return Err("Left operand of '||' must be a Boolean".to_string()),
                        }
                    }
                    _ => {
                        let left_val = self.eval_expr(*left)?;
                        let right_val = self.eval_expr(*right)?;
                        self.eval_binary(op, &left_val, &right_val)
                    }
                }
            }
            Expression::Unary { op, operand } => {
                let val = self.eval_expr(*operand)?;
                match op {
                    UnaryOp::Not => match val.as_ref() {
                        Value::Boolean(b) => Ok(Value::boolean(!b)),
                        _ => Err("Operand of '!' must be a Boolean".to_string()),
                    },
                }
            }
            Expression::FunctionLiteral { params, return_type, body } => {
                // Validate: each param must have type annotation or default value.
                for p in &params {
                    if p.type_expr.is_none() && p.default.is_none() {
                        return Err(format!(
                            "Function parameter '{}' must have a type annotation or default value",
                            p.name
                        ));
                    }
                }
                Ok(Value::function(params, return_type, body))
            }
            Expression::Call { callee, args } => {
                let func_val = self.eval_expr(*callee)?;
                match func_val.as_ref() {
                    Value::Function { params, return_type, body } => {
                        let params = params.clone();
                        let return_type = return_type.clone();
                        let body = body.clone();
                        self.exec_function_call(&params, args, &body, &return_type)
                    }
                    Value::NativeFunction { func, param_count, name } => {
                        let mut arg_vals = Vec::new();
                        for arg in args {
                            arg_vals.push(self.eval_expr(arg)?);
                        }
                        if arg_vals.len() != *param_count {
                            return Err(format!(
                                "Native function '{}' expects {} argument(s), got {}",
                                name, param_count, arg_vals.len()
                            ));
                        }
                        (func.0)(arg_vals)
                    }
                    _ => Err("Cannot call non-function value".to_string()),
                }
            }
            Expression::TypeCheck { expr, type_expr, negated } => {
                let val = self.eval_expr(*expr)?;
                let matches = self.value_matches_type_expr(&val, &type_expr, &mut Vec::new());
                let result = if negated { !matches } else { matches };
                Ok(Value::boolean(result))
            }
            Expression::Replace { variable, list, condition, replacement } => {
                let list_val = self.eval_expr(*list)?;
                match list_val.as_ref() {
                    Value::Array(elements) => {
                        let mut result = Vec::new();
                        for element in elements {
                            self.env.push_scope();
                            self.env.define(variable.clone(), element.clone());
                            let cond = self.eval_expr(*condition.clone())?;
                            match cond.as_ref() {
                                Value::Boolean(true) => {
                                    let repl = self.eval_expr(*replacement.clone())?;
                                    result.push(repl);
                                }
                                Value::Boolean(false) => {
                                    result.push(element.clone());
                                }
                                _ => {
                                    self.env.pop_scope();
                                    return Err("replace 'where' condition must be Boolean".to_string());
                                }
                            }
                            self.env.pop_scope();
                        }
                        Ok(Value::array(result))
                    }
                    _ => Err("replace 'in' value must be an Array".to_string()),
                }
            }
        }
    }

    /// Evaluate a binary operation.
    fn eval_binary(
        &self,
        op: BinaryOp,
        left: &Value,
        right: &Value,
    ) -> Result<Rc<Value>, String> {
        match op {
            BinaryOp::Equal => {
                let result = values_equal(left, right);
                Ok(Value::boolean(result))
            }
            BinaryOp::NotEqual => {
                let result = !values_equal(left, right);
                Ok(Value::boolean(result))
            }
            BinaryOp::Add => {
                match (left, right) {
                    // String + String = concatenation
                    (Value::String(a), Value::String(b)) => {
                        Ok(Value::string(format!("{}{}", a, b)))
                    }
                    // String + any = string concat
                    (Value::String(a), other) => {
                        Ok(Value::string(format!("{}{}", a, other)))
                    }
                    // any + String = string concat
                    (other, Value::String(b)) => {
                        Ok(Value::string(format!("{}{}", other, b)))
                    }
                    // Array + Array = concat
                    (Value::Array(a), Value::Array(b)) => {
                        let mut result = a.clone();
                        result.extend(b.iter().cloned());
                        Ok(Value::array(result))
                    }
                    // Array + value = append
                    (Value::Array(a), val) => {
                        let mut result = a.clone();
                        result.push(Rc::new(val.clone()));
                        Ok(Value::array(result))
                    }
                    // value + Array = prepend
                    (val, Value::Array(b)) => {
                        let mut result = vec![Rc::new(val.clone())];
                        result.extend(b.iter().cloned());
                        Ok(Value::array(result))
                    }
                    // Number + Number = addition
                    (Value::Number(a), Value::Number(b)) => {
                        Ok(Value::number(a + b))
                    }
                    _ => Err(format!(
                        "Cannot use '+' with {} and {}",
                        left.type_name(), right.type_name()
                    )),
                }
            }
            BinaryOp::Sub => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::number(a - b)),
                    _ => Err(format!("Cannot use '-' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::Mul => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::number(a * b)),
                    _ => Err(format!("Cannot use '*' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::Div => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => {
                        if *b == 0.0 {
                            Err("Division by zero".to_string())
                        } else {
                            Ok(Value::number(a / b))
                        }
                    }
                    _ => Err(format!("Cannot use '/' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::Less => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::boolean(a < b)),
                    _ => Err(format!("Cannot use '<' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::Greater => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::boolean(a > b)),
                    _ => Err(format!("Cannot use '>' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::LessEqual => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::boolean(a <= b)),
                    _ => Err(format!("Cannot use '<=' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            BinaryOp::GreaterEqual => {
                match (left, right) {
                    (Value::Number(a), Value::Number(b)) => Ok(Value::boolean(a >= b)),
                    _ => Err(format!("Cannot use '>=' with {} and {}", left.type_name(), right.type_name())),
                }
            }
            // And/Or handled above with short-circuit.
            BinaryOp::And | BinaryOp::Or => unreachable!(),
        }
    }
}

/// Deep equality comparison for Values, including nested objects and Null.
fn values_equal(left: &Value, right: &Value) -> bool {
    match (left, right) {
        (Value::Null, Value::Null) => true,
        (Value::Number(a), Value::Number(b)) => a == b,
        (Value::String(a), Value::String(b)) => a == b,
        (Value::Boolean(a), Value::Boolean(b)) => a == b,
        (Value::Array(a), Value::Array(b)) => {
            if a.len() != b.len() {
                return false;
            }
            a.iter().zip(b.iter()).all(|(av, bv)| values_equal(av, bv))
        }
        (Value::Object(a), Value::Object(b)) => {
            if a.len() != b.len() {
                return false;
            }
            a.iter().all(|(k, v)| {
                b.get(k)
                    .map(|bv| values_equal(v, bv))
                    .unwrap_or(false)
            })
        }
        _ => false,
    }
}
