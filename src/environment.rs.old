use std::collections::HashMap;
use std::rc::Rc;

use crate::ast::{Statement, TypeExpr};
use crate::native_module::NativeFnPtr;
use crate::runtime::Value;

/// Scope-stack environment for Code's memory model.
///
/// Variables store references (`Rc<Value>`) to heap-allocated values.
/// Scopes are organized as a stack of frames (`Vec<HashMap>`).
/// When a scope is popped, all its references are dropped;
/// if no other references remain, the heap value is deallocated.
///
/// Type system support:
/// - `type_annotations`: optional type name per variable binding.
/// - `type_registry`: named particle type definitions (from `type` declarations).
///   Fields are `(name, type_name, is_optional)`.
/// - `handler_registry`: handler definitions keyed by particle class name.
pub struct Environment {
    scopes: Vec<HashMap<String, Rc<Value>>>,
    /// Type annotation for each variable: scope-index -> name -> TypeExpr.
    type_annotations: Vec<HashMap<String, TypeExpr>>,
    /// Type definitions (particle schemas): name -> field list `(name, TypeExpr, optional)`.
    type_registry: Vec<HashMap<String, Vec<(String, TypeExpr, bool)>>>,
    /// Handler definitions: class_name -> handler body (statements).
    handler_registry: Vec<HashMap<String, Vec<Statement>>>,
    /// Type alias definitions: alias name -> TypeExpr.
    type_alias_registry: Vec<HashMap<String, TypeExpr>>,
    /// Native handler definitions: class_name -> native function wrapper.
    native_handler_registry: Vec<HashMap<String, NativeFnPtr>>,
}

impl Environment {
    /// Create a new environment with an empty global scope.
    /// Pre-registers the built-in `Exception` type.
    pub fn new() -> Self {
        let mut env = Environment {
            scopes: vec![HashMap::new()],
            type_annotations: vec![HashMap::new()],
            type_registry: vec![HashMap::new()],
            handler_registry: vec![HashMap::new()],
            type_alias_registry: vec![HashMap::new()],
            native_handler_registry: vec![HashMap::new()],
        };
        // Register built-in Exception type.
        env.define_type("Exception".to_string(), vec![
            ("message".to_string(), TypeExpr::Named("String".to_string()), false),
            ("innerException".to_string(), TypeExpr::Named("Exception".to_string()), true),
        ]);
        env
    }

    /// Push a new (empty) scope frame onto the stack.
    pub fn push_scope(&mut self) {
        self.scopes.push(HashMap::new());
        self.type_annotations.push(HashMap::new());
        self.type_registry.push(HashMap::new());
        self.handler_registry.push(HashMap::new());
        self.type_alias_registry.push(HashMap::new());
        self.native_handler_registry.push(HashMap::new());
    }

    /// Pop the innermost scope frame.
    /// All references held in that frame are dropped.
    /// Panics if attempting to pop the global scope.
    pub fn pop_scope(&mut self) {
        if self.scopes.len() <= 1 {
            panic!("Cannot pop the global scope");
        }
        self.scopes.pop();
        self.type_annotations.pop();
        self.type_registry.pop();
        self.handler_registry.pop();
        self.type_alias_registry.pop();
        self.native_handler_registry.pop();
    }

    /// Define a variable in the **current** (innermost) scope.
    pub fn define(&mut self, name: String, value: Rc<Value>) {
        self.scopes
            .last_mut()
            .expect("No active scope")
            .insert(name, value);
    }

    /// Define a variable with a type annotation in the current scope.
    pub fn define_typed(&mut self, name: String, type_expr: TypeExpr, value: Rc<Value>) {
        self.scopes
            .last_mut()
            .expect("No active scope")
            .insert(name.clone(), value);
        self.type_annotations
            .last_mut()
            .expect("No active scope")
            .insert(name, type_expr);
    }

    /// Reassign an existing variable, searching from the innermost scope outward.
    /// Replaces the reference with a new `Rc<Value>`.
    /// Returns an error string if the variable is not defined in any scope.
    pub fn assign(&mut self, name: &str, value: Rc<Value>) -> Result<(), String> {
        for scope in self.scopes.iter_mut().rev() {
            if scope.contains_key(name) {
                scope.insert(name.to_string(), value);
                return Ok(());
            }
        }
        Err(format!("Undefined variable '{}'", name))
    }

    /// Look up a variable, searching from the innermost scope outward.
    /// Returns a cloned `Rc` (cheap reference-count bump).
    pub fn get(&self, name: &str) -> Option<Rc<Value>> {
        for scope in self.scopes.iter().rev() {
            if let Some(val) = scope.get(name) {
                return Some(Rc::clone(val));
            }
        }
        None
    }

    /// Get the type annotation for a variable, if any.
    pub fn get_type_annotation(&self, name: &str) -> Option<&TypeExpr> {
        for scope in self.type_annotations.iter().rev() {
            if let Some(t) = scope.get(name) {
                return Some(t);
            }
        }
        None
    }

    /// Register a type definition in the current scope.
    pub fn define_type(&mut self, name: String, fields: Vec<(String, TypeExpr, bool)>) {
        self.type_registry
            .last_mut()
            .expect("No active scope")
            .insert(name, fields);
    }

    /// Look up a type definition, searching from innermost scope outward.
    pub fn get_type(&self, name: &str) -> Option<&Vec<(String, TypeExpr, bool)>> {
        for scope in self.type_registry.iter().rev() {
            if let Some(fields) = scope.get(name) {
                return Some(fields);
            }
        }
        None
    }

    /// Register a type alias in the current scope.
    pub fn define_type_alias(&mut self, name: String, type_expr: TypeExpr) {
        self.type_alias_registry
            .last_mut()
            .expect("No active scope")
            .insert(name, type_expr);
    }

    /// Look up a type alias, searching from innermost scope outward.
    pub fn get_type_alias(&self, name: &str) -> Option<&TypeExpr> {
        for scope in self.type_alias_registry.iter().rev() {
            if let Some(te) = scope.get(name) {
                return Some(te);
            }
        }
        None
    }

    /// Check whether a variable exists in any scope (for shadowing checks).
    pub fn exists_in_any_scope(&self, name: &str) -> bool {
        self.scopes.iter().any(|scope| scope.contains_key(name))
    }

    /// Check whether a variable exists in the current (innermost) scope only.
    pub fn current_scope_has(&self, name: &str) -> bool {
        self.scopes
            .last()
            .map(|scope| scope.contains_key(name))
            .unwrap_or(false)
    }

    /// Register a handler definition in the current scope.
    /// Returns an error if a handler for this class already exists in the current scope.
    pub fn define_handler(&mut self, class_name: String, body: Vec<Statement>) -> Result<(), String> {
        let scope = self.handler_registry.last_mut().expect("No active scope");
        if scope.contains_key(&class_name) {
            return Err(format!(
                "Duplicate handler for '{}': only one handler per particle class per scope",
                class_name
            ));
        }
        scope.insert(class_name, body);
        Ok(())
    }

    /// Look up a handler by class name, searching from innermost scope outward.
    pub fn get_handler(&self, class_name: &str) -> Option<&Vec<Statement>> {
        for scope in self.handler_registry.iter().rev() {
            if let Some(body) = scope.get(class_name) {
                return Some(body);
            }
        }
        None
    }

    /// Look up all handlers by class name outside the current (innermost) scope.
    ///
    /// Returned in nearest-to-farthest order.
    pub fn get_handlers_outside_current_scope(&self, class_name: &str) -> Vec<Vec<Statement>> {
        self.handler_registry
            .iter()
            .rev()
            .skip(1)
            .filter_map(|scope| scope.get(class_name).cloned())
            .collect()
    }

    // -----------------------------------------------------------------------
    // Native handler registry
    // -----------------------------------------------------------------------

    /// Register a native handler in the current scope.
    pub fn define_native_handler(&mut self, class_name: String, func: NativeFnPtr) -> Result<(), String> {
        let scope = self.native_handler_registry.last_mut().expect("No active scope");
        if scope.contains_key(&class_name) {
            return Err(format!(
                "Duplicate native handler for '{}': only one handler per particle class per scope",
                class_name
            ));
        }
        scope.insert(class_name, func);
        Ok(())
    }

    /// Look up a native handler by class name, searching from innermost scope outward.
    pub fn get_native_handler(&self, class_name: &str) -> Option<&NativeFnPtr> {
        for scope in self.native_handler_registry.iter().rev() {
            if let Some(f) = scope.get(class_name) {
                return Some(f);
            }
        }
        None
    }

    /// Look up all native handlers by class name outside the current scope.
    pub fn get_native_handlers_outside_current_scope(&self, class_name: &str) -> Vec<NativeFnPtr> {
        self.native_handler_registry
            .iter()
            .rev()
            .skip(1)
            .filter_map(|scope| scope.get(class_name).cloned())
            .collect()
    }

    /// Save the current scope stack, replacing it with a fresh isolated scope.
    /// Returns the saved state which can be restored later.
    /// Type definitions, type aliases, and handler definitions are cloned
    /// into the fresh scope so that the function body can reference known types/handlers.
    pub fn save_and_isolate_scopes(&mut self) -> (
        Vec<HashMap<String, Rc<Value>>>,
        Vec<HashMap<String, TypeExpr>>,
        Vec<HashMap<String, Vec<(String, TypeExpr, bool)>>>,
        Vec<HashMap<String, Vec<Statement>>>,
        Vec<HashMap<String, TypeExpr>>,
        Vec<HashMap<String, NativeFnPtr>>,
    ) {
        // Collect all types from all scopes into one map.
        let mut merged_types = HashMap::new();
        for scope in &self.type_registry {
            for (k, v) in scope {
                merged_types.insert(k.clone(), v.clone());
            }
        }
        // Collect all type aliases from all scopes into one map.
        let mut merged_aliases = HashMap::new();
        for scope in &self.type_alias_registry {
            for (k, v) in scope {
                merged_aliases.insert(k.clone(), v.clone());
            }
        }
        // Do NOT carry handlers into function scope – handler def/invoke is
        // prohibited inside functions, so the registry starts empty.

        let saved_scopes = std::mem::replace(&mut self.scopes, vec![HashMap::new()]);
        let saved_annotations = std::mem::replace(&mut self.type_annotations, vec![HashMap::new()]);
        let saved_types = std::mem::replace(&mut self.type_registry, vec![merged_types]);
        let saved_handlers = std::mem::replace(&mut self.handler_registry, vec![HashMap::new()]);
        let saved_aliases = std::mem::replace(&mut self.type_alias_registry, vec![merged_aliases]);
        let saved_native_handlers = std::mem::replace(&mut self.native_handler_registry, vec![HashMap::new()]);

        (saved_scopes, saved_annotations, saved_types, saved_handlers, saved_aliases, saved_native_handlers)
    }

    /// Restore a previously saved scope stack.
    pub fn restore_scopes(
        &mut self,
        saved: (
            Vec<HashMap<String, Rc<Value>>>,
            Vec<HashMap<String, TypeExpr>>,
            Vec<HashMap<String, Vec<(String, TypeExpr, bool)>>>,
            Vec<HashMap<String, Vec<Statement>>>,
            Vec<HashMap<String, TypeExpr>>,
            Vec<HashMap<String, NativeFnPtr>>,
        ),
    ) {
        self.scopes = saved.0;
        self.type_annotations = saved.1;
        self.type_registry = saved.2;
        self.handler_registry = saved.3;
        self.type_alias_registry = saved.4;
        self.native_handler_registry = saved.5;
    }

}
