-- The two things a program does that you can watch: loop, and say something.
link "console" as out

let names = ["ada", "grace", "alan"]

loop name over names {
    emit Print { value = "hello, $name" } to out
}

-- Handlers answer particles, and a handler can print too.
Greet { who } => {
    emit Print { value = "greeting $who" } to out
    return Greeting { text = "hello, $who" }
}

loop name over names {
    emit Greet { who = name } to this get greeting
    emit Print { value = greeting.text } to out
}
