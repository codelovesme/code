link "console" as out
LineTotal { item } =>
    return Line { name = item.name, value = item.count * item.price }
items = [
    { name = "apples", count = 2, price = 3 }
    { name = "bread", count = 1, price = 2 }
]
total = 0
loop item over items
    emit LineTotal { item = item } to this get line
    total += line.value
    emit Print { value = "$line.name: $line.value" } to out
emit Print { value = "total: $total" } to out
