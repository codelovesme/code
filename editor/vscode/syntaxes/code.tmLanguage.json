{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Code",
  "scopeName": "source.code",
  "comment": "Fallback highlighting only. The language server's semantic tokens (crates/code-lsp/src/tokens.rs) are the real thing and override this wherever it is running; this is what a reader gets without it. Keep the keyword list in step with lexer.rs — that is the only authority.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#link-statement" },
    { "include": "#number" },
    { "include": "#constant" },
    { "include": "#keyword-control" },
    { "include": "#keyword-module" },
    { "include": "#keyword-logical" },
    { "include": "#emit-target" },
    { "include": "#handler-definition" },
    { "include": "#type-name" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "comment": "`|` to end of line, the marker since 2.0.0. First in the list so a `|` is never read as anything else.",
      "name": "comment.line.pipe.code",
      "match": "\\|.*$"
    },
    "string": {
      "name": "string.quoted.double.code",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.code" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.code" } },
      "patterns": [
        { "name": "constant.character.escape.code", "match": "\\\\." },
        {
          "comment": "`$name` and `$name.field` splice a value in.",
          "name": "variable.other.interpolation.code",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
        }
      ]
    },
    "link-statement": {
      "comment": "The path is a quoted string, so `#string` colours it; only the keywords and the alias are taken here.",
      "match": "\\b(link)\\b(?:.*\\b(as)\\s+([a-z_][a-zA-Z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.import.code" },
        "2": { "name": "keyword.control.import.code" },
        "3": { "name": "entity.name.namespace.code" }
      }
    },
    "number": {
      "name": "constant.numeric.code",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "constant": {
      "name": "constant.language.code",
      "match": "\\b(true|false|null)\\b"
    },
    "keyword-control": {
      "name": "keyword.control.code",
      "match": "\\b(if|loop|over|break|continue|return|emit|to|get|assert)\\b"
    },
    "keyword-module": {
      "name": "keyword.control.import.code",
      "match": "\\b(link|unlink|as)\\b"
    },
    "keyword-logical": {
      "comment": "`is` is deliberately absent: it is still a reserved word, but only so that typing it is answered with `the membership operator is '∈'`. Colouring it would suggest it works.",
      "name": "keyword.operator.logical.code",
      "match": "\\b(and|or|not)\\b"
    },
    "emit-target": {
      "comment": "The three targets that are words rather than aliases.",
      "name": "variable.language.code",
      "match": "\\b(this|base|core)\\b"
    },
    "handler-definition": {
      "comment": "`Name { fields } =>` or `Name =>` at the start of a line. A body is the indented run below it, so there is no brace to look for.",
      "match": "^\\s*([A-Z][a-zA-Z0-9_]*)\\s*(?=(\\{[^}]*\\})?\\s*=>)",
      "captures": { "1": { "name": "entity.name.type.handler.code" } }
    },
    "type-name": {
      "comment": "An uppercase-first name is a particle class wherever it is read — brace or no brace — and can never be a variable.",
      "name": "entity.name.type.code",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.code", "match": "=>" },
        { "name": "keyword.operator.assignment.code", "match": "\\+=" },
        { "name": "keyword.operator.membership.code", "match": "[∈∉]" },
        { "name": "keyword.operator.comparison.code", "match": "[=≠<>≤≥]" },
        { "name": "keyword.operator.arithmetic.code", "match": "[+\\-*/]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "\\{", "name": "punctuation.section.object.begin.code" },
        { "match": "\\}", "name": "punctuation.section.object.end.code" },
        { "match": "\\[", "name": "punctuation.section.array.begin.code" },
        { "match": "\\]", "name": "punctuation.section.array.end.code" },
        { "match": "\\(", "name": "punctuation.section.parens.begin.code" },
        { "match": "\\)", "name": "punctuation.section.parens.end.code" },
        { "match": ",", "name": "punctuation.separator.comma.code" },
        { "match": "\\.", "name": "punctuation.accessor.dot.code" }
      ]
    },
    "identifier": {
      "name": "variable.other.code",
      "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
    }
  }
}
