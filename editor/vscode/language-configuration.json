{
  "comments": {
    "lineComment": "|"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "(^\\s*(if|loop)\\b(?![^|]*,).*$)|(.*(\\{|\\[|\\()\\s*(\\|.*)?$)|(.*=>\\s*(\\|.*)?$)",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*(\\{|\\[|\\()\\s*(\\|.*)?$",
      "afterText": "^\\s*[}\\])]",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "(^\\s*(if|loop)\\b(?![^|]*,).*$)|(.*(\\{|\\[|\\()\\s*(\\|.*)?$)|(.*=>\\s*(\\|.*)?$)",
      "action": { "indent": "indent" }
    }
  ]
}
