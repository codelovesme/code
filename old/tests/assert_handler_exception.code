-> Assert on Exception inside handler returns Exception to caller

Check = Particle ∩ { _class ∈ "Check", value ∈ Number }

Check => {
    response = Exception { message = "Something failed" }
    assert response
    return Check { value = 0 }
}

emit Check { value = 42 } to this get result
assert result ∈ Exception
assert result.message = "Something failed"

-> Assert false inside handler returns Exception to caller

Run = Particle ∩ { _class ∈ "Run" }

Run => {
    assert false
    return Run {}
}

emit Run {} to this get result2
assert result2 ∈ Exception
assert result2.message = "Assertion failed"

-> Assert true inside handler continues normally

Greet = Particle ∩ { _class ∈ "Greet", name ∈ String }
Greeting = Particle ∩ { _class ∈ "Greeting", text ∈ String }

Greet => {
    assert true
    return Greeting { text = "Hello" }
}

emit Greet { name = "World" } to this get result3
assert result3 ∈ Greeting
assert result3.text = "Hello"

-> Assert on non-exception value inside handler continues normally

Compute = Particle ∩ { _class ∈ "Compute", x ∈ Number }
Answer = Particle ∩ { _class ∈ "Answer", value ∈ Number }

Compute => {
    assert x
    return Answer { value = x * 2 }
}

emit Compute { x = 5 } to this get result4
assert result4 ∈ Answer
assert result4.value = 10
