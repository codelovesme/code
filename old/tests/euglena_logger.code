-> Test: logger handles Log and LogException particles
link euglena/src/organelles/logger

-> Send a Log locally
emit Log { message = "test msg", level = "Debug" } to this get ack
assert ack._class = "ACK"
assert ack.source = "logger"

-> Send a LogException
emit LogException { source = "unit-test", message = "oops" } to this get ack2
assert ack2._class = "ACK"
assert ack2.source = "logger"
