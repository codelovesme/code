-> Persistence organelle: handles Save and Load particles
link ../particles/common

Save = Particle ∩ { _class ∈ "Save", key ∈ String, value ∈ String }
Load = Particle ∩ { _class ∈ "Load", key ∈ String }
LoadResult = Particle ∩ { _class ∈ "LoadResult", key ∈ String, found ∈ Boolean, value ∈ String }

Save => {
    return ACK { source = "persistence" }
}

Load => {
    return LoadResult { key = key, found = false, value = "" }
}
