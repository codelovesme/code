n = 32768
values = []
state = 17
i = 0
loop
    if i = n, break
    values += { x = state, y = 1024 - state, z = state * 2 }
    state = state + 17
    if state ≥ 1024, state = state - 1024
    i = i + 1
result = 0
round = 0
loop
    if round = 16, break
    answer = 0
    i = 0
    loop
        if i = n, break
        v = values[i]
        answer = answer + v.x * (round + 1) + v.y * 3 - v.z * 2
        i = i + 1
    result = result + answer
    round = round + 1
assert result = 2012872704
