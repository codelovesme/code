| Complete histories: matching retained values, including validation and cleanup.
payload_size = __PAYLOAD__
section_count = __SECTIONS__
version_count = 64
document = __DOCUMENT__
payload = "a"
size = 1
loop
    if size = payload_size, break
    payload += payload
    size = size * 2
current = []
i = 0
loop
    if i = section_count, break
    current += [{ enabled = false, text = payload }]
    i += 1
snapshots = []
step = 0
loop
    if step = version_count, break
    snapshots += [current]
    if document
        current[0].text = current[0].text[0, step) + "b" + current[0].text[step + 1, length)
    if not document
        current[step].enabled = true
    step += 1
snapshots += [current]
expected = payload
prefix = ""
seen = 0
loop v, saved over snapshots
    checked_sections = 0
    loop index, item over saved
        assert item.enabled = (not document and index < v)
        assert item.text = expected
        checked_sections += 1
    assert checked_sections = section_count
    if document and v < version_count
        prefix += "b"
        expected = prefix + payload[v + 1, length)
    seen += 1
assert seen = version_count + 1
