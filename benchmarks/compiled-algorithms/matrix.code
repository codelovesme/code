| Dense row-major matrix product, identical i/k/j traversal in all languages.
n = __SIZE__
a = []
b = []
c = []
i = 0
loop
    if i = n, break
    j = 0
    loop
        if j = n, break
        a += (i + j + 1) / n
        b += (i * 2 + j + 1) / n
        c += 0
        j = j + 1
    i = i + 1
i = 0
loop
    if i = n, break
    k = 0
    loop
        if k = n, break
        x = a[i * n + k]
        j = 0
        loop
            if j = n, break
            c[i * n + j] = c[i * n + j] + x * b[k * n + j]
            j = j + 1
        k = k + 1
    i = i + 1
sum_k = n * (n - 1) / 2
sum_k2 = n * (n - 1) * (2 * n - 1) / 6
i = 0
loop
    if i = n, break
    j = 0
    loop
        if j = n, break
        u = i + 1
        v = j + 1
        expected = (2 * sum_k2 + (2 * u + v) * sum_k + n * u * v) / (n * n)
        difference = c[i * n + j] - expected
        assert difference > -0.00000001 and difference < 0.00000001
        j = j + 1
    i = i + 1
