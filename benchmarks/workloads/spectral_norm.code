| Spectral norm (Benchmarks Game), N = 1000, ten power iterations — the same
| arithmetic as spectral_norm.c and .rs. There is no `sqrt` in the language,
| so the last step is a few Newton iterations.
n = 1000

Times { vec, t } =>
    out = []
    row = 0
    loop
        if row = n, break
        sum = 0
        col = 0
        loop
            if col = n, break
            a = 1 / ((row + col) * (row + col + 1) / 2 + row + 1 + t * (col - row))
            sum = sum + a * vec[col]
            col = col + 1
        out += sum
        row = row + 1
    return Vec { value = out }

u = []
i = 0
loop
    if i = n, break
    u += 1
    i = i + 1
v = []
k = 0
loop
    if k = 10, break
    emit Times { vec = u, t = 0 } to this get w
    emit Times { vec = w.value, t = 1 } to this get x
    v = x.value
    emit Times { vec = v, t = 0 } to this get w2
    emit Times { vec = w2.value, t = 1 } to this get y
    u = y.value
    k = k + 1
vbv = 0
vv = 0
loop i2, ui over u
    vbv = vbv + ui * v[i2]
    vv = vv + v[i2] * v[i2]
ratio = vbv / vv
g = ratio
step = 0
loop
    if step = 60, break
    g = (g + ratio / g) / 2
    step = step + 1
assert g > 1.274224
assert g < 1.274225
