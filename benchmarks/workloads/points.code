| Points: 1,000 objects { x, y, vx, vy } moved 200 steps, bouncing off a
| 1,000 × 1,000 box — the shape of a game or animation frame. Each point is
| changed where it stands (`pts[i].x = x`), the way the C and Rust versions
| do it.
count = 1000
steps = 200
pts = []
i = 0
loop
    if i = count, break
    pts += { x = i, y = 1000 - i, vx = 3, vy = -2 }
    i = i + 1
s = 0
loop
    if s = steps, break
    i = 0
    loop
        if i = count, break
        x = pts[i].x + pts[i].vx
        y = pts[i].y + pts[i].vy
        if x < 0 or x > 1000
            pts[i].vx = 0 - pts[i].vx
        if y < 0 or y > 1000
            pts[i].vy = 0 - pts[i].vy
        pts[i].x = x
        pts[i].y = y
        i = i + 1
    s = s + 1
sum = 0
loop p over pts
    sum = sum + p.x + p.y
assert sum = 1001398
