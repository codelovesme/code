| Eratosthenes sieve, inclusive upper bound. Full count and sum are verified.
n = 1000000
prime = []
i = 0
loop
    if i > n, break
    prime += true
    i = i + 1
prime[0] = false
prime[1] = false
count = 0
sum = 0
i = 2
loop
    if i > n, break
    if prime[i]
        count = count + 1
        sum = sum + i
    i = i + 1
assert count = n - 1
assert sum = n * (n + 1) / 2 - 1
