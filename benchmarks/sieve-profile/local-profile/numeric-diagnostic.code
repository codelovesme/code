| Eratosthenes sieve, inclusive upper bound. Full count and sum are verified.
n = 1000000
prime = []
i = 0
loop
    if i > n, break
    prime += 1
    i = i + 1
prime[0] = 0
prime[1] = 0
p = 2
loop
    if p * p > n, break
    if prime[p] = 1
        multiple = p * p
        loop
            if multiple > n, break
            prime[multiple] = 0
            multiple = multiple + p
    p = p + 1
count = 0
sum = 0
i = 2
loop
    if i > n, break
    if prime[i] = 1
        count = count + 1
        sum = sum + i
    i = i + 1
assert count = 78498
assert sum = 37550402023
