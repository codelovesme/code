# Rust build artifacts
/target/
**/target/

# Playground build output — assembled by site/build.py + wasm-bindgen at
# deploy time (.github/workflows/pages.yml), never committed.
/dist/

# Editor / OS
.DS_Store
*.swp

# Native test modules — compiled by tests/run_language_tests.rs from the
# checked-in .c source, not committed themselves (see native-module-linking
# in docs/todo for why a prebuilt .so isn't portable across machines).
/tests/native_modules/*.so
/tests/native_modules/*.a
/tests/native_modules/*.o
