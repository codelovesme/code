# Rust build artifacts
/target/
**/target/

# Playground build output — assembled by site/build.py + wasm-bindgen at
# deploy time (.github/workflows/pages.yml), never committed.
/dist/

# npm package build output — assembled by crates/code-wasm/npm/build.sh,
# same not-committed-binaries convention as /dist/ above.
/crates/code-wasm/npm/dist/
/crates/code-wasm/npm/*.tgz

# Editor / OS
.DS_Store
*.swp

# Native test modules — built by tests/run_language_tests.rs from the
# checked-in source (Rust crates for the .so doubles, .c for the two .a
# ones), not committed themselves (see native-module-linking in docs/todo
# for why a prebuilt artifact isn't portable across machines).
/tests/native_modules/*.so
/tests/native_modules/*.a
/tests/native_modules/*.o
