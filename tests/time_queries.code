| Querying time is stateless; core's compatibility entry points still work.
link "native_modules/time.so" as time
emit Timestamp to core get before
emit Timestamp to time get clock
emit Timestamp to core get after
assert clock ∈ TimestampResult
| Two readings of the wall clock, not one: core's may come from a coarser
| source than the module's, so at a second's edge the module can already
| be in the next second. One second either side is the same instant.
assert clock.value ≥ before.value - 1
assert clock.value ≤ after.value + 1
emit TimezoneOffset to time get local
emit TimezoneOffset to core get original
assert local ∈ TimezoneOffsetResult
assert local.value = original.value
assert local.value ≥ - 1440
assert local.value ≤ 1440
emit UnknownClock to time get unknown
assert unknown = null

ClockSnapshot =>
    emit Timestamp to core get core_time
    emit Timestamp to time get module_time
    emit TimezoneOffset to time get offset
    return Snapshot { core_value = core_time.value, value = module_time.value, offset = offset.value }
