-- Exercises a handler that returns a *fresh* heap-owned string (not a
-- borrowed literal) — the boundary case `code_native_copy_in`/`ffi_to_value`
-- have to get right, since that memory belongs to the module's own
-- allocator and becomes invalid the moment the module's own `code_release`
-- runs on it.
link "native_modules/test_math.so" as m
emit Shout { value = "whisper" } to m get n
assert n = { _class = "ShoutResult", value = "WHISPER!" }
