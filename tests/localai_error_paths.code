| `localai` — the paths that need no model server. The chat and
| transcription round trips are in tests/localai_module.rs, against a fake
| OpenAI-compatible endpoint on loopback.
link "native_modules/localai.so" as ai

| Nothing works before Config.
emit Chat { user = "hi" } to ai get early
assert early ∈ Exception
assert early.source = "localai"

| Config validates the endpoint.
emit Config {} to ai get short
assert short ∈ Exception

emit Config { endpoint = "http://127.0.0.1:1" } to ai get c
assert c ∈ ConfigResult
assert c.ok

| A Chat with no content is refused before the network.
emit Chat {} to ai get empty
assert empty ∈ Exception

| messages must be an array of { role, content }.
emit Chat { messages = "not an array" } to ai get badmsg
assert badmsg ∈ Exception

| audio_base64 that isn't base64 is caught before the network.
emit Transcribe { audio_base64 = "!! not base64 !!" } to ai get badaudio
assert badaudio ∈ Exception

| A well-formed request against an endpoint nothing answers on is an
| Exception (connection refused), not a hang.
emit Chat { system = "s", user = "u" } to ai get refused
assert refused ∈ Exception

emit Transcribe { audio_base64 = "aGVsbG8=" } to ai get refused2
assert refused2 ∈ Exception

| A class this module does not handle is null.
emit Embed {} to ai get u
assert u = null
