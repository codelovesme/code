-- `.a` static modules only work with `code build` (there is no `dlopen` for
-- a static archive) — the `buildonly_` prefix tells the fixture harness this
-- one must succeed under `code build` and fail under `code run`, unlike
-- every other fixture here. See docs/todo/native-module-linking.md.
link "native_modules/test_math_static.a" as m
emit Sum { "value": [1, 2, 3, 4, 5] } to m get n
assert n = { "_class": "SumResult", "value": 15 }
