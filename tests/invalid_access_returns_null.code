-- invalid property/index access is not an error — it returns null (decided
-- 2026-08-21, permissive/JS-like rather than erroring, unlike undefined
-- variables which do still error)
let point = { "x": 1 }
let missing_field = point.z

let n = 42
let field_on_number = n.x

let nums = [1, 2]
let out_of_bounds = nums[5]
let non_integer_index = nums[0.5]
let index_on_object = point[0]
let field_on_array = nums.x
