-- A value built inside a loop body can outlive the iteration that built it,
-- by being copied into a binding from an enclosing scope. The body's storage
-- is therefore NOT reusable as scratch across iterations — each iteration's
-- array has to stay intact for as long as something still refers to it.
let saved = []
let seen = []
loop x over [1, 2, 3] {
    let pair = [x, x * 10]
    if x == 1 {
        saved = pair
    }
    seen = seen + [pair]
}
assert saved == [1, 10]
assert seen == [[1, 10], [2, 20], [3, 30]]

-- Same thing one level deeper: the escaping value is nested inside another
-- value that also escapes.
let boxes = []
loop x over ["a", "b"] {
    let inner = { "k": x }
    boxes = boxes + [{ "wrapped": inner }]
}
assert boxes[0].wrapped.k == "a"
assert boxes[1].wrapped.k == "b"
