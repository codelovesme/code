-- The same `link`ed module serves both roles at once: `m.<name>` reads its
-- exported variables, and `emit ... to m` dispatches into its handlers. The
-- alias is one name with two jobs — a value object *and* an emit target.
link "native_modules/test_math.so" as m
emit Double { value = m.answer } to m get doubled
assert doubled = { _class = "DoubleResult", value = 84 }
assert m.answer = 42
