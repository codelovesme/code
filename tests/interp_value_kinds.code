-- Interpolation is total: every kind has a spelling, so no value is
-- uninterpolable. A string splices in bare (quoting it would make
-- `"$s"` read `"hi"` instead of `hi`); everything else renders as the
-- same compact JSON the language uses everywhere else, which means a
-- string *nested* inside an array or object keeps its quotes.
let s = "hi"
let whole = 3
let frac = 2.5
let yes = true
let nothing = null
let arr = [1, "a"]
let obj = { k = 1 }

assert "$s" = "hi"
assert "$whole" = "3"
assert "$frac" = "2.5"
assert "$yes" = "true"
assert "$nothing" = "null"
assert "$arr" = "[1,\"a\"]"
assert "$obj" = "{\"k\":1}"

-- Nesting and negatives, still JSON.
let nested = { items = [1, [2]], name = "ada" }
assert "$nested" = "{\"items\":[1,[2]],\"name\":\"ada\"}"

let neg = -4
assert "$neg" = "-4"
