-> Split handler definition: type declared separately, handler declared later
Alert = Particle ∩ { _class ∈ "Alert", text ∈ String }
Ack = Particle ∩ { _class ∈ "Ack", ok ∈ Number }

Alert => {
    assert text = "fire"
    return Ack{ ok = 1 }
}

emit Alert{text = "fire"} to this get result
assert result.ok = 1
