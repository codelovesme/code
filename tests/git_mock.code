| `git_mock` — a drop-in for `git` that runs no `git` and reaches no
| remote. State is a small in-memory model.
link "native_modules/git_mock.so" as git

emit Commit { message = "x" } to git get early
assert early ∈ Exception
assert early.source = "git_mock"

emit Config { repo_path = "/tmp/does-not-matter", branch = "trunk" } to git get c
assert c ∈ ConfigResult
assert c.ok
assert c.dirty = false
assert c.branch = "trunk"
assert c.head = ""

| A fresh mock repo is clean.
emit Status {} to git get s0
assert s0.clean
assert s0.output = ""

| Committing with nothing staged is refused, like git.
emit Commit { message = "empty" } to git get noop
assert noop ∈ Exception

emit Add { pattern = "src" } to git get add
assert add ∈ AddResult
assert add.pattern = "src"

emit Status {} to git get s1
assert s1.clean = false

emit Commit { message = "first" } to git get cm
assert cm ∈ CommitResult
assert cm.message = "first"

| After the commit the tree is clean again.
emit Status {} to git get s2
assert s2.clean

emit Push {} to git get push
assert push ∈ PushResult
assert push.remote = "origin"

emit SetRemote { name = "origin", url = "https://user:secret@example.com/r.git" } to git get sr
assert sr.name = "origin"
assert sr.url = "https://***@example.com/r.git"

| Stash tracks whether there was anything to stash.
emit Stash {} to git get st
assert st.changed = false
emit Add { pattern = "." } to git get _
emit Stash {} to git get st2
assert st2.changed
emit StashPop {} to git get sp
assert sp.changed

emit Init { path = "/tmp/mock-init" } to git get i
assert i.path = "/tmp/mock-init"

emit Bisect {} to git get u
assert u = null
