link "native_modules/strings.so" as length_strings
| `emit` is an ordinary statement, usable anywhere a statement is —
| including inside a loop body, unlike `link`/`export` which are
| module-structure declarations confined to the top level.
lengths = []
loop word over ["a", "bb", "ccc"]
    emit Length { value = word } to length_strings get n
    lengths += [n.value]
assert lengths = [1, 2, 3]
