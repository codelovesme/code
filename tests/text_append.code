| Every interpolation part sees the old accumulator, including repeated aliases.
s = "a"
s += "$s$s"
assert s = "aaa"
held = s
n = 12
s = s + "-$n,"
assert held = "aaa"
assert s = "aaa-12,"
s += "$s"
assert s = "aaa-12,aaa-12,"
xs = []
xs += "$n,"
assert xs = ["12,"]
s = ""
a = [1, "é", null]
s += "$a"
assert s = "[1,\"é\",null]"
| The fractional renderer remains shared with ordinary interpolation.
values = [-0, 0, 1, -123, 9007199254740992, 9007199254740994, 1000000000000000000000, 0.1]
s = ""
expected = ""
loop v over values
    s += "$v,"
    part = "$v,"
    expected += part
assert s = expected
assert s = "-0,0,1,-123,9007199254740992,9007199254740994,1000000000000000000000,0.1,"
big = 1
i = 0
loop
    if i = 1100, break
    big = big * 2
    i += 1
nan = big - big
assert "$nan" = "NaN"
assert "$big" = "inf"
negative = -big
assert "$negative" = "-inf"
s = ""
s += "$nan,$big,$negative"
assert s = "NaN,inf,-inf"

| Every value kind, in both assignment spellings and in a handler's loop.
Append { count, item ∈ Any } =>
    text = ""
    text += "$item"
    j = 0
    loop
        if j = count, break
        text = text + "|$j:$item"
        j += 1
    return Appended { value = text }
number = 4
word = "é"
flag = true
nothing = null
record = { x = 7, y = "z" }
text = ""
text += "$number:$word:$flag:$nothing:$record"
assert text = "4:é:true:null:{\"x\":7,\"y\":\"z\"}"
emit Append { count = 2, item = record } to this get answer
assert answer.value = "{\"x\":7,\"y\":\"z\"}|0:{\"x\":7,\"y\":\"z\"}|1:{\"x\":7,\"y\":\"z\"}"
emit Append { count = 1, item = flag } to this get boolean_answer
assert boolean_answer.value = "true|0:true"
emit Append { count = 1, item = nothing } to this get null_answer
assert null_answer.value = "null|0:null"
emit Append { count = 1, item = word } to this get text_answer
assert text_answer.value = "é|0:é"
emit Append { count = 1, item = number } to this get number_answer
assert number_answer.value = "4|0:4"

| A failed fallback leaves the old destination intact and unwinds the frame.
old ∈ Any = { x = 1 }
FailAppend {} =>
    old += "$number"
    return Unexpected {}
emit FailAppend {} to this get failure
assert failure ∈ Exception
assert old = { x = 1 }
assert failure.source = "core"
assert failure.message = "cannot apply '+' to an object and a string"
