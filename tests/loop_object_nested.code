-- Containers nest freely: an object of arrays, and an array of objects,
-- each walked with the same `loop k, v over` form.
let byCity = { nyc = [1, 2], sf = [3] }
let allValues = []
loop city, nums over byCity {
    loop i, n over nums {
        allValues = allValues + [n]
    }
}
assert allValues = [1, 2, 3]

let people = [{ name = "a" }, { name = "b" }]
let names = []
loop i, person over people {
    names = names + [person.name]
}
assert names = ["a", "b"]
