| Several interpolations in one string: adjacent (`$a$b`, no literal
| between them), leading, and trailing. The name runs to the first
| character that can't continue an identifier, which is what lets
| `$user.` and `$n items` end where a reader expects.
let a = "one"
let b = "two"
let user = "ada"
let n = 3

assert "$a$b" = "onetwo"
assert "$a and $b" = "one and two"
assert "hello $user." = "hello ada."
assert "$n items left" = "3 items left"
assert "trailing $a" = "trailing one"

| `.` and `[` do not chain inside a string: the name stops at `$user`,
| and the rest is literal text. Interpolation takes a bare variable, not
| an expression.
let box = { lid = "shut" }
assert "$box.lid" = "{\"lid\":\"shut\"}.lid"
