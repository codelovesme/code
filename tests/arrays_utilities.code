source = [{ id = "first", score = 2 }, { id = "second", score = 1 }]
emit Sort { value = source, by = "score" } to a get ordered
assert source[0].id = "first"
assert ordered.value[0].id = "second"
emit Reverse { value = source } to a get reversed
emit Slice { value = source, start = 0, end = 1 } to a get sliced
emit Unique { value = source } to a get unique
source[0].id = "changed"
assert ordered.value[1].id = "first"
assert reversed.value[1].id = "first"
assert sliced.value[0].id = "first"
assert unique.value[0].id = "first"
emit Length { value = [1, 2] } to core get compatible
assert compatible.value = 2
emit NotAnArrayHandler to a get unknown
assert unknown = null
