| Structural equality, stable Unicode ordering and non-mutating transforms.
link "native_modules/arrays.so" as a
emit Length { value = [] } to a get r0
assert r0 = { _class = "LengthResult", value = 0 }
emit Reverse { value = [] } to a get r1
assert r1 = { _class = "ReverseResult", value = [] }
emit Length { value = [null, false, 0, "", [], {}] } to a get r2
assert r2 = { _class = "LengthResult", value = 6 }
emit Reverse { value = [null, false, 0, "", [], {}] } to a get r3
assert r3 = { _class = "ReverseResult", value = [{}, [], "", 0, false, null] }
emit Length { value = [{ a = 1, b = [2, 3] }, { b = [2, 3], a = 1 }, [1, 2], [2, 1], false, 0, null] } to a get r4
assert r4 = { _class = "LengthResult", value = 7 }
emit Reverse { value = [{ a = 1, b = [2, 3] }, { b = [2, 3], a = 1 }, [1, 2], [2, 1], false, 0, null] } to a get r5
assert r5 = { _class = "ReverseResult", value = [null, 0, false, [2, 1], [1, 2], { b = [2, 3], a = 1 }, { a = 1, b = [2, 3] }] }
emit Contains { value = [], item = null } to a get r6
assert r6 = { _class = "ContainsResult", value = false }
emit Contains { value = [1, 2, 1], item = 1 } to a get r7
assert r7 = { _class = "ContainsResult", value = true }
emit Contains { value = [false, 0], item = 0 } to a get r8
assert r8 = { _class = "ContainsResult", value = true }
emit Contains { value = [0, false], item = false } to a get r9
assert r9 = { _class = "ContainsResult", value = true }
emit Contains { value = [{ a = 1, b = [2, 3] }], item = { b = [2, 3], a = 1 } } to a get r10
assert r10 = { _class = "ContainsResult", value = true }
emit Contains { value = [[1, 2]], item = [2, 1] } to a get r11
assert r11 = { _class = "ContainsResult", value = false }
emit Contains { value = [[], {}], item = {} } to a get r12
assert r12 = { _class = "ContainsResult", value = true }
emit Contains { value = [null], item = null } to a get r13
assert r13 = { _class = "ContainsResult", value = true }
emit Contains { value = [] } to a get r14
assert r14 = { _class = "ContainsResult", value = false }
emit Contains { value = [null] } to a get r15
assert r15 = { _class = "ContainsResult", value = true }
emit IndexOf { value = [], item = null } to a get r16
assert r16 = { _class = "IndexOfResult", value = -1 }
