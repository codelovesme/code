| A loop has no accumulator form of its own: what survives it is an ordinary
| binding declared before it, which the body assigns like any other name that
| reaches outward. `loop ... get out = init` used to say this in the header
| and meant exactly the two lines below, so it went on 2026-09-09.
sum = 0
loop x over [1, 2, 3]
    sum += x
assert sum = 6

| Any value kind works — it is an ordinary binding.
joined = ""
loop s over ["a", "b", "c"]
    joined += s
assert joined = "abc"

| It can be read as well as written, including across iterations.
running = []
loop x over [1, 2, 3]
    running += [x]
assert running = [1, 2, 3]

| A body that never assigns it leaves it at what it started as, which is the
| same thing an empty container does.
untouched = null
loop x over [1], assert true
assert untouched = null

never = 7
loop x over []
    never = 0
assert never = 7
