-- `continue` skips the rest of the iteration and starts the next one.
loop x over [1, 2, 3, 4] get kept = [] {
    if x = 2 {
        continue
    }
    kept = kept + [x]
}
assert kept = [1, 3, 4]

-- Statements after a `continue` never run.
loop x over [1, 2] get seen = 0 {
    seen = seen + 1
    continue
    seen = seen + 100
}
assert seen = 2

-- In a bare `loop { }`, `continue` re-enters the body immediately.
let i = 0
let reached = 0
loop {
    i = i + 1
    if i = 2 {
        continue
    }
    reached = reached + 1
    if i = 4 {
        break
    }
}
assert i = 4
assert reached = 3

-- `continue` affects only the innermost loop.
loop x over [1, 2] get rows = [] {
    loop y over [1, 2, 3] get cols = [] {
        if y = 2 {
            continue
        }
        cols = cols + [y]
    }
    rows = rows + [cols]
}
assert rows = [[1, 3], [1, 3]]
