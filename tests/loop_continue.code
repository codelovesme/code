| `continue` skips the rest of the iteration and starts the next one.
kept = []
loop x over [1, 2, 3, 4]
    if x = 2
        continue
    kept += [x]
assert kept = [1, 3, 4]

| Statements after a `continue` never run.
seen = 0
loop x over [1, 2]
    seen += 1
    continue
    seen += 100
assert seen = 2

| In a bare `loop`, `continue` re-enters the body immediately.
i = 0
reached = 0
loop
    i += 1
    if i = 2
        continue
    reached += 1
    if i = 4
        break
assert i = 4
assert reached = 3

| `continue` affects only the innermost loop.
rows = []
loop x over [1, 2]
    cols = []
    loop y over [1, 2, 3]
        if y = 2
            continue
        cols += [y]
    rows += [cols]
assert rows = [[1, 3], [1, 3]]
