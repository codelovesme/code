| Configuration owns the destination; requests carry only particles.
link "native_modules/net_client.so" as net

emit Send { particle = Ping {} } to net get unconfigured
assert unconfigured ∈ Exception
emit Config {} to net get missing_url
assert missing_url ∈ Exception
emit Config { url = "https://127.0.0.1:9/x" } to net get scheme
assert scheme ∈ Exception
emit Config { url = "http://127.0.0.1/x" } to net get noport
assert noport ∈ Exception
emit Config { url = "http://127.0.0.1:9/a/b" } to net get deep
assert deep ∈ Exception
emit Config { url = "http://127.0.0.1:9/x" } to net get configured
assert configured.ok
emit Send { url = "http://127.0.0.1:9/other", particle = Ping {} } to net get override
assert override ∈ Exception
emit Send { particle = 5 } to net get notparticle
assert notparticle ∈ Exception
emit Send {} to net get missing
assert missing ∈ Exception
emit Send { particle = Ping {}, timeout_ms = 0 } to net get zero
assert zero ∈ Exception
