| A block may hold its statement on the same line: the `}` that closes the
| block ends the statement, the way a newline or `;` does.
|
| This is what makes the guard clause writable, and with no `else` in the
| language a run of guards is how a multi-way conditional is spelled.

Grade { score } => {
    if score ≥ 90 { return G { letter = "A" } }
    if score ≥ 80 { return G { letter = "B" } }
    if score ≥ 60 { return G { letter = "C" } }
    return G { letter = "F" }
}

emit Grade { score = 94 } to this get a
assert a.letter = "A"
emit Grade { score = 85 } to this get b
assert b.letter = "B"
emit Grade { score = 71 } to this get c
assert c.letter = "C"
emit Grade { score = 40 } to this get d
assert d.letter = "F"

| Every block form, not just a handler's `if`.
let n = 0
loop { n = n + 1
    if n = 5 { break } }
assert n = 5

loop x over [1, 2, 3] get total = 0 { total = total + x }
assert total = 6

if true { let inner = 1 }

| A newline still separates, and means the same thing.
if true {
    let a = 2
}
