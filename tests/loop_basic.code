-- `loop x over arr { }` runs the body once per element, in order, with `x`
-- bound to that element. There is no `yield`/collect form — accumulating
-- goes through the array `+` that already exists.
let items = [10, 20, 30]
let doubled = []
loop item over items {
    doubled = doubled + [item * 2]
}
assert doubled == [20, 40, 60]

-- The body sees the element itself, whatever kind it is.
let names = ["ada", "grace"]
let joined = ""
loop name over names {
    joined = joined + name
}
assert joined == "adagrace"
