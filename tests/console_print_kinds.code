| `Print` renders whatever value kind it's handed, so a program can show a
| number, a boolean, or even an array without first converting it by hand.
| Each emit prints one line and returns the character count, asserted here
| so the rendering rules (integral numbers stay integral, booleans/null use
| their literal names, containers report their size) are pinned down in both
| output modes.
|
| The last value is long enough to force the module's internal buffer to grow
| past its initial capacity mid-render — the realloc path, exercised for free.
link "native_modules/console.so" as con

emit Print { value = 42 } to con get r1
assert r1.value = 2

emit Print { value = true } to con get r2
assert r2.value = 4

emit Print { value = null } to con get r3
assert r3.value = 4

emit Print { value = [1, 2, 3] } to con get r4
assert r4.value = 9

let long_line = "a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i" + "j"
long_line = long_line + long_line + long_line + long_line
emit Print { value = long_line } to con get r5
assert r5.value = 40
