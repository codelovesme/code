-- The iterable is any expression, not just a bare name or a literal.
let total = []
loop x over [1, 2] + [3] {
    total = total + [x]
}
assert total == [1, 2, 3]

-- Including a field access that yields an array.
let data = { "xs": [7, 8] }
let got = []
loop x over data.xs {
    got = got + [x]
}
assert got == [7, 8]
