link "native_modules/arrays.so" as length_arrays
| Failed module and handler calls answer Exceptions; unknown core calls answer
| null. Every caller reaches the statement after its emit.
link "native_modules/math.so" as math

Bad {} =>
    | Not a particle, on purpose: the label says the answer may be anything.
    answer ∈ Any = 42
    return answer

Viacore {} =>
    emit UnhandledCoreParticle to core get r
    return Reached { r = r }
Viamodule {} =>
    emit Double {} to math get r
    return Reached { r = r }
Viahandler {} =>
    emit Bad {} to this get r
    return Reached { r = r }

emit Viacore {} to this get a
emit Viamodule {} to this get b
emit Viahandler {} to this get c

| The point: every one of them got past the emit.
assert a ∈ Reached
assert b ∈ Reached
assert c ∈ Reached

assert a.r = null
assert b.r ∈ Exception
assert c.r ∈ Exception

| And they name who could not do it, which is the one thing that differs.
| An unhandled core particle answers null.
assert b.r.source = "math"
assert c.r.source = "core"
