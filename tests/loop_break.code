| `break` exits the innermost loop immediately — the rest of the body is
| skipped for that iteration too.
nums = [1, 2, 3, 4, 5]
taken = []
loop n over nums
    if n > 3
        break
    taken += [n]
assert taken = [1, 2, 3]

| `break` reaches out through any number of `if` bodies — it exits the
| enclosing *loop*, not the enclosing block.
hit = []
loop n over nums

    if n = 2
        break
    hit += [n]
assert hit = [1]

| Breaking before the accumulator is touched leaves it empty: the
| statements after `break` never run at all.
none = []
loop n over nums
    break
    none += [n]
assert none = []
