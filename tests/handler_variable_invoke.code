-> Handler invocation using a variable (not a literal)
Msg = Particle ∩ { _class ∈ "Msg", content ∈ String }
Echo = Particle ∩ { _class ∈ "Echo", text ∈ String }

Msg => {
    return Echo{ text = content }
}

m = Msg{content = "hello world"}
emit m to this get result
assert result.text = "hello world"
