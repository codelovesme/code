| Every way a `link` inside a handler can go wrong is a value, not the end of
| the program. That is the point: a program that opens modules it worked
| out at runtime has to survive the ones it cannot open, the same way
| `http_client_unreachable.code` survives a refused connection.

| A note on the paths below. A top-level `link` is resolved by `loader.rs`
| against the *file* that says it, which is why other fixtures write
| `native_modules/x.so`. A `link` inside a handler cannot work that way: its
| path is a value that does not exist until the program runs, and a compiled
| binary carries no source tree to resolve against. So it is taken as an
| ordinary path, relative to the working directory — and these fixtures run
| from the crate root.
Missing {} => {
    link "tests/native_modules/nosuch.so" as m
    return Loaded {}
}
emit Missing {} to this get a
assert a._class = "Exception"

| A `.a` is linked into this binary at build time and has nothing to open; a
| `.code` source would mean adding handlers while the program runs. Only a
| `.so` is a module in the sense this statement means.
NotAnModule {} => {
    link "tests/native_modules/test_math_static.a" as m
    return Loaded {}
}
emit NotAnModule {} to this get b
assert b._class = "Exception"

| The path is a value, so it can be the wrong kind of value.
NotAPath {} => {
    link 5 as m
    return Loaded {}
}
emit NotAPath {} to this get d
assert d._class = "Exception"

| An address is something the runtime minted. Anything else emitted to is a
| mistake worth naming, not a lookup that quietly finds nothing.
Forged {} => {
    let fake = { "_module" = 99 }
    emit Double { value = 1 } to fake get r
    return r
}
emit Forged {} to this get e
assert e._class = "Exception"

NotAnAddress {} => {
    let nope = 5
    emit Double { value = 1 } to nope get r
    return r
}
emit NotAnAddress {} to this get f
assert f._class = "Exception"

| Unlinking something that was never linked, and unlinking twice.
UnlinkForged {} => {
    let fake = { "_module" = 99 }
    unlink fake
    return Unlinked {}
}
emit UnlinkForged {} to this get g
assert g._class = "Exception"

UnlinkTwice {} => {
    link "tests/native_modules/test_math.so" as m
    unlink m
    unlink m
    return Unlinked {}
}
emit UnlinkTwice {} to this get h
assert h._class = "Exception"
