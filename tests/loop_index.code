-- `loop item, i over arr { }` also binds the zero-based position.
let colors = ["red", "green", "blue"]
let positions = []
loop color, i over colors {
    positions = positions + [i]
}
assert positions == [0, 1, 2]

-- The index is an ordinary Number, usable in arithmetic.
let shifted = []
loop n, i over [10, 20, 30] {
    shifted = shifted + [n + i]
}
assert shifted == [10, 21, 32]
