| `assert x` where `x` is an `Exception` ends the frame, and the frame's own
| answer carries the original underneath — which is what
| `Exception.innerException` is a field for. The message quotes the one
| beneath it, because at the top level the message is all that gets printed.
Read {} => {
    emit Length { value = 5 } to core get bad
    assert bad
    return Never {}
}

| Anything else false has nothing underneath it.
Plain {} => {
    assert 0
    return Never {}
}

emit Read {} to this get answer
assert answer ∈ Exception
assert answer.source = "core"
assert answer.message = "assertion failed: Length requires an array or string 'value', found a number"
assert answer.innerException ∈ Exception
assert answer.innerException.source = "core"
assert answer.innerException.message = "Length requires an array or string 'value', found a number"

emit Plain {} to this get flat
assert flat ∈ Exception
assert flat.message = "assertion failed"
assert flat.innerException = null
