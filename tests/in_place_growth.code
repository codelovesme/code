| `name += value` and `name = name + value` grow the variable's own value
| where it stands when nothing else holds it (ticket 121). Nothing about the
| answers may change: whatever else holds the old value still sees the old
| value.

| A list grown alone, then shared and grown: the other holder keeps its own.
xs = []
i = 0
loop
    if i = 100, break
    xs += i
    i = i + 1
emit Length { value = xs } to core get { value as n }
assert n = 100
assert xs[99] = 99
ys = xs
xs += 100
assert xs[100] = 100
assert ys[100] = null
emit Length { value = ys } to core get { value as m }
assert m = 100

| Appending a list to itself, and a list as one element.
zs = [1, 2]
zs = zs + zs
assert zs = [1, 2, 1, 2]
zs += [[3]]
assert zs = [1, 2, 1, 2, [3]]
zs = zs + [4, 5]
assert zs[6] = 5

| Growing a list while walking it: the walk sees the list it started with.
ws = [1, 2, 3]
seen = 0
loop w over ws
    ws += w
    seen = seen + 1
assert seen = 3
assert ws = [1, 2, 3, 1, 2, 3]

| An element taken out keeps its value when the list grows past it.
first = ws[0]
ws += 9
assert first = 1

| Text: from a literal, then grown alone, then shared.
s = "a"
s = s + "b"
s += "c"
assert s = "abc"
t = s
s += "d"
assert t = "abc"
assert s = "abcd"
s = s + 1
assert s = "abcd1"
lit = "x"
copy = lit
lit += "y"
assert copy = "x"

| Objects: a field replaced where it stands, a shared one left alone, a new
| field added on the end.
counts = { a = 0, b = 0 }
counts = counts + { a = counts.a + 1 }
assert counts = { a = 1, b = 0 }
before = counts
counts = counts + { b = 5 }
assert before = { a = 1, b = 0 }
assert counts = { a = 1, b = 5 }
counts = counts + { c = 7 }
assert counts = { a = 1, b = 5, c = 7 }
key = "a"
counts = counts + { "$key" = counts[key] + 10 }
assert counts.a = 11

| Lists of objects grown inside a handler, returned, and grown again.
Collect { count } =>
    out = []
    k = 0
    loop
        if k = count, break
        out += { k = k }
        k = k + 1
    return Collected { value = out }
emit Collect { count = 5 } to this get got
items = got.value
items += { k = 5 }
assert items[5].k = 5
emit Collect { count = 5 } to this get again
assert again.value[4] = { k = 4 }

| An object grown one field at a time, past several moves to a bigger block,
| with keys long and short: every field keeps its name, value and place.
table = { first = "one" }
i = 0
loop
    if i = 40, break
    table = table + { "key-number-$i-with-a-long-name" = i, "k$i" = [i] }
    i = i + 1
fields = 0
names = []
loop name, value over table
    fields = fields + 1
    names += name
assert fields = 81
assert table.first = "one"
assert table["key-number-0-with-a-long-name"] = 0
assert table["key-number-39-with-a-long-name"] = 39
assert table.k17 = [17]
assert names[0] = "first"
assert names[1] = "key-number-0-with-a-long-name"
assert names[2] = "k0"
assert names[80] = "k39"

| Shared, then grown: the other holder sees neither the new field nor the new
| value; replaced and added in one step.
kept = table
table = table + { first = "uno", last = "end" }
assert kept.first = "one"
assert kept.last = null
assert table.first = "uno"
assert table.last = "end"
after = []
loop name, value over table
    after += name
assert after[81] = "last"
assert after[82] = null
kept_fields = 0
loop name, value over kept
    kept_fields = kept_fields + 1
assert kept_fields = 81

| An object holding itself, and a field naming itself twice the old way.
self = { a = 1 }
self = self + { me = self }
assert self.me = { a = 1 }
self += { b = 2 }
assert self = { a = 1, me = { a = 1 }, b = 2 }

| A text's length is measured once and kept with it: growing it many times,
| from a shared copy, and with characters wider than a byte, the answers stay
| the text's own.
long = ""
step = 0
loop
    if step = 300, break
    long += "ab"
    step = step + 1
emit Length { value = long } to core get { value as long_size }
assert long_size = 600
twin = long
long += "çé"
twin += "x"
emit Length { value = long } to core get { value as grown_size }
emit Length { value = twin } to core get { value as twin_size }
assert grown_size = 602
assert twin_size = 601
assert long[600, length) = "çé"
assert twin[598, length) = "abx"
long += long
emit Length { value = long } to core get { value as doubled }
assert doubled = 1204
assert long[length - 2, length) = "çé"

| `name = name[from, to)` cuts the variable's own list where it stands when
| nothing else holds it: a stack popped, a queue's head dropped, a list
| emptied — and a list someone else holds is left as it was.
stack = [1, [2], { three = 3 }, "four"]
top = stack[length - 1]
stack = stack[0, length - 1)
assert stack = [1, [2], { three = 3 }]
assert top = "four"
kept_stack = stack
stack = stack[0, length - 1)
assert stack = [1, [2]]
assert kept_stack = [1, [2], { three = 3 }]
queue = [10, 20, 30, 40, 50]
queue = queue[1, length)
assert queue = [20, 30, 40, 50]
queue = queue[1, 3]
assert queue = [30, 40, 50]
queue = queue[5, 9]
assert queue = []
queue += 60
assert queue = [60]
wide = [1, 2, 3]
wide = wide[0 - 5, 99]
assert wide = [1, 2, 3]
word = "héllo"
word = word[1, length)
assert word = "éllo"
