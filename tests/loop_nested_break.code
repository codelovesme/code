-- `break` exits only the innermost loop — the outer one keeps going, so
-- this collects exactly one element per outer iteration.
let seen = []
loop a over [1, 2, 3] {
    loop b over [10, 20, 30] {
        if b > 10 {
            break
        }
        seen = seen + [a + b]
    }
}
assert seen == [11, 12, 13]
